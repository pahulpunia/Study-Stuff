rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function memberName() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.name;
    }
    // points can only go up, by a sane amount, and the name must match the account
    function okScore(oldTotal, oldRounds) {
      let d = request.resource.data;
      return d.name == memberName()
        && d.total is int && d.total >= oldTotal && d.total <= oldTotal + 50000
        && d.rounds is int && d.rounds > oldRounds && d.rounds <= oldRounds + 50
        && d.vocab is int && d.math is int && d.best is int;
    }

    // holds the club password. Nobody can read it from the app.
    match /config/{doc} {
      allow read, write: if false;
    }

    // you can only join if you know the club password
    match /members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.invite == get(/databases/$(database)/documents/config/invite).data.code
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9_]{3,16}$');
      allow update, delete: if false;
    }

    // leaderboard: members can see everyone, but only write their own row
    match /scores/{uid} {
      allow read: if isMember();
      allow create: if isMember() && request.auth.uid == uid && okScore(0, 0);
      allow update: if isMember() && request.auth.uid == uid && okScore(resource.data.total, resource.data.rounds);
      allow delete: if false;
    }
  }
}
