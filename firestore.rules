rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    // the site owner: create admins/{your uid} by hand in the Firebase console
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function memberName() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.name;
    }
    // points can only go up, by a sane amount, and the name must match the account
    function okScore(oldTotal, oldRounds) {
      let d = request.resource.data;
      return d.name == memberName()
        && d.total is int && d.total >= oldTotal && d.total <= oldTotal + 50000
        && d.rounds is int && d.rounds > oldRounds && d.rounds <= oldRounds + 50
        && d.vocab is int && d.math is int && d.best is int;
    }

    // holds the club password. Nobody can read it from the app.
    match /config/{doc} {
      allow read, write: if false;
    }

    // admin list: only changed in the Firebase console
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // you can only join if you know the club password
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.invite == get(/databases/$(database)/documents/config/invite).data.code
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9_]{3,16}$');
      allow update, delete: if false;
    }

    // progress sync: each member's own stats, so they match on every device
    match /progress/{uid} {
      allow read: if isMember() && (request.auth.uid == uid || isAdmin());
      allow write: if isMember() && request.auth.uid == uid;
    }

    // club stats: how often each question is missed (powers "Tough Ones")
    match /qstats/{subject} {
      allow read: if isMember();
      allow create, update: if isMember() && request.resource.data.keys().hasOnly(['q']);
      allow delete: if false;
    }

    // round history: each finished round, saved to the account that played it.
    // You see your own; the admin sees everyone's. Nobody can edit history.
    match /rounds/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'subj', 'mode', 'sec', 'score', 'right', 'total', 'secs', 'quit', 'at', 'when'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.name == memberName()
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100000
        && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 500
        && request.resource.data.right is int && request.resource.data.right >= 0 && request.resource.data.right <= request.resource.data.total
        && request.resource.data.secs is int && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // problem reports. Anyone can read them (they show in Settings → Issues without names);
    // members can file one; only the admin can change the status, reply, or delete.
    match /issues/{id} {
      allow read: if true;
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['kind', 'reason', 'text', 'subj', 'where', 'q', 'qk', 'status', 'reply', 'created', 'updated'])
        && request.resource.data.status == 'open' && request.resource.data.reply == ''
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && request.resource.data.q is string && request.resource.data.q.size() <= 400
        && request.resource.data.created == request.time
        && existsAfter(/databases/$(database)/documents/issueAuthors/$(id));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'updated']);
      allow delete: if isAdmin();
    }
    // who filed each report, kept separately so names stay private (you see your own; the admin sees all)
    match /issueAuthors/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'created'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.name == memberName()
        && existsAfter(/databases/$(database)/documents/issues/$(id));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // leaderboard: members can see everyone, but only write their own row
    match /scores/{uid} {
      allow read: if isMember();
      allow create: if isMember() && request.auth.uid == uid && okScore(0, 0);
      allow update: if isMember() && request.auth.uid == uid && okScore(resource.data.total, resource.data.rounds);
      allow delete: if false;
    }
  }
}
